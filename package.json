{
  "name": "gurkencheck",
  "version": "0.4.0",
  "displayName": "gurkencheck",
  "description": "A Gherkin linter/validator written in TypeScript, with no build step beyond tsc",
  "keywords": [
    "gherkin",
    "cucumber",
    "cucumberjs",
    "cucumber-js",
    "gherkin-lint",
    "gherkin-linter",
    "cucumber-lint",
    "linter",
    "lint",
    "validator",
    "static-analysis",
    "code-quality",
    "feature-file",
    "feature-files",
    "bdd",
    "behavior-driven-development",
    "acceptance-testing",
    "specification-by-example",
    "testing",
    "tests",
    "sarif",
    "typescript"
  ],
  "license": "ISC",
  "author": "Sebastian Schürmann",
  "publisher": "maschinenlesbar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebs/gurkencheck.git"
  },
  "homepage": "https://sebs.maschinenlesbar.org/gurkencheck/",
  "bugs": {
    "url": "https://github.com/sebs/gurkencheck/issues"
  },
  "type": "module",
  "main": "./dist/vscode/extension.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "gurkencheck": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0",
    "vscode": "^1.105.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/*.feature",
    "onLanguage:feature",
    "onLanguage:cucumber",
    "onLanguage:gherkin"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gurkencheck.restart",
        "title": "Restart the language server",
        "category": "gurkencheck"
      }
    ]
  },
  "dependencies": {
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/vscode": "~1.105.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "docs": "node site/build.ts",
    "generate:rules": "node scripts/generate-rules.ts",
    "demo": "node src/main.ts examples",
    "prepare": "npm run build",
    "package:vscode": "npm run build && npx --yes @vscode/vsce@4.1.1 package"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sebs"
  }
}
